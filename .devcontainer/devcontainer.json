{
  "name": "Data Cleaning Agent",
  "build": {
    "dockerfile": "../Dockerfile",
    // Override the production CMD so the container stays alive for development
    "args": {}
  },
  "overrideCommand": true,
  "postCreateCommand": "pip install --no-cache-dir poetry==1.8.3 && poetry config virtualenvs.create false && poetry install --no-interaction --no-ansi",

  // Forward Streamlit port
  "forwardPorts": [8501],
  "portsAttributes": {
    "8501": {
      "label": "Streamlit",
      "onAutoForward": "openBrowser"
    }
  },

  // Mount your .env so the API key is available without hardcoding it
  "mounts": [
    "source=${localWorkspaceFolder}/.env,target=/app/.env,type=bind,consistency=cached"
  ],

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "ms-python.black-formatter",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "ms-python.black-formatter"
        }
      }
    }
  }
}
